# Home-Rank configuration. Copy this file to .env and uncomment what you need.
#
# Local development needs none of these: it uses the dev database from
# docker/compose.dev.yaml and a throwaway secret key. Production requires the
# variables marked "required" and refuses to start without them.

# Required in production. A long random string that signs sessions and tokens.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# SECRET_KEY=

# Required in production. Comma-separated hostnames this instance answers to.
# ALLOWED_HOSTS=chess.example.org

# Required in production. Development defaults to the value shown here.
# DATABASE_URL=postgres://homerank:homerank@localhost:5432/homerank

# Required in production. true if users reach Home-Rank over https:// (usually through a
# reverse proxy): cookies are then only sent over HTTPS, http:// redirects to https://, and
# browsers are told to use HTTPS only. false for plain http:// on a local network, where those
# would make logging in impossible.
# HTTPS=true

# Optional. true only behind a reverse proxy that sets X-Forwarded-Proto and X-Forwarded-For.
# Home-Rank then knows whether a request came in over HTTPS, and which address to count failed
# logins against. Never without such a proxy: visitors could fake both headers.
# TRUST_PROXY_HEADERS=false

# Optional, rarely needed. Comma-separated origins allowed to submit forms, e.g.
# https://chess.example.org, if the reverse proxy can't report that requests use HTTPS.
# CSRF_TRUSTED_ORIGINS=

# Optional. Path of the Django admin, ending in a slash. A less obvious path keeps bots away.
# ADMIN_URL=admin/
