# Home-Rank configuration. Copy this file to .env next to it.
#
# Self-hosting with Docker Compose (docs/self-hosting.md): fill in the four required values
# below. `docker compose up` refuses to start while one of them is empty.
#
# Local development needs none of this: it ignores the required values and uses the dev
# database and a throwaway secret key. Uncomment an optional setting to change it.

# ---------------------------------------------------------------- required

# A long random string that signs sessions. Keep it secret; changing it logs everyone out.
# Generate one with: openssl rand -hex 32
SECRET_KEY=

# Password of the database. Generate one with: openssl rand -hex 24
# Use only letters and digits: it becomes part of a URL. Changing it later needs more than
# editing this line (see docs/self-hosting.md).
POSTGRES_PASSWORD=

# Comma-separated hostnames or IP addresses this instance answers to, e.g. chess.example.org
# or 192.168.1.20. localhost always works.
ALLOWED_HOSTS=

# true if users reach Home-Rank over https:// (usually through a reverse proxy): cookies are
# then only sent over HTTPS, http:// redirects to https://, and browsers are told to use HTTPS
# only. false for plain http:// on a local network, where those would make logging in
# impossible.
HTTPS=

# ---------------------------------------------------------------- optional

# Docker Compose only. Where the website listens on this machine: a port, or an address and a
# port. 127.0.0.1:8000 makes it reachable only from this machine, e.g. for a reverse proxy.
# HOMERANK_PORT=8000

# true only behind a reverse proxy that sets X-Forwarded-Proto and X-Forwarded-For. Home-Rank
# then knows whether a request came in over HTTPS, and which address to count failed logins
# against. Never without such a proxy: visitors could fake both headers.
# TRUST_PROXY_HEADERS=false

# Rarely needed. Comma-separated origins allowed to submit forms, e.g.
# https://chess.example.org, if the reverse proxy can't report that requests use HTTPS.
# CSRF_TRUSTED_ORIGINS=

# Path of the Django admin, ending in a slash. A less obvious path keeps bots away.
# ADMIN_URL=admin/

# Logs are one JSON object per line (json), for log collectors, or readable lines (console)
# for reading `docker compose logs` directly. LOG_LEVEL is DEBUG, INFO, WARNING or ERROR.
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# Docker only. The web container applies database migrations when it starts; set false to
# apply them by hand instead (docker compose run --rm web python manage.py migrate).
# MIGRATE_ON_START=true

# The largest PGN file users may upload, in MB. 200 MB hold about 70,000 games with clock
# comments. A reverse proxy in front of Home-Rank must allow uploads this large too.
# IMPORT_MAX_MB=200

# Hours between the automatic syncs of each linked Lichess or Chess.com account; 0 turns them
# off (users can still press "Sync now").
# SYNC_INTERVAL_HOURS=6

# Your email address or a URL, sent along with every request to Lichess and Chess.com, so the
# sites can contact you instead of blocking your server if something goes wrong. Optional.
# SYNC_CONTACT=you@example.org

# Docker only. Number of web server processes. Each handles one request at a time and briefly
# needs ~100 MiB to check a password at login, so keep it small on small machines.
# WEB_WORKERS=2

# Without Docker Compose only, which builds this from POSTGRES_PASSWORD: the database to use.
# Development defaults to the value shown here; set it to use a different database.
# DATABASE_URL=postgres://homerank:homerank@localhost:5432/homerank
