# Entries for Python, Node etc. are added in the step that introduces each tool.

# Local configuration and secrets: .env.example is committed, real .env files never.
.env
.env.*
!.env.example
# A self-hoster's own additions to compose.yaml, e.g. for a reverse proxy.
compose.override.yaml

# Python
.venv/
__pycache__/
*.py[cod]
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
backend/staticfiles/

# Node (frontend)
node_modules/
frontend/dist/
# Playwright: results, reports and the saved login of the end-to-end tests
frontend/test-results/
frontend/playwright-report/
frontend/e2e/.auth/

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# Uploaded files waiting for import (backend DATA_DIR) in local development
/data/
